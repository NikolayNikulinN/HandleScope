<UserControl x:Class="HandleScope.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:HandleScope.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding AppTitle, Source={StaticResource ResourceWrapper}}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="{Binding AppSubtitle, Source={StaticResource ResourceWrapper}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,18"
                Padding="16"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="TargetPathInput"
                         Grid.Column="0"
                         Margin="0,0,12,0"
                         AllowDrop="True"
                         materialDesign:HintAssist.Hint="{Binding TargetPathHint, Source={StaticResource ResourceWrapper}}"
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:TextFieldAssist.TextBoxViewMargin="0,0,12,0"
                         PreviewDragOver="OnTargetPathPreviewDragOver"
                         PreviewDrop="OnTargetPathPreviewDrop"
                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="1"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseCommand}"
                        Content="{Binding BrowseButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Style="{StaticResource SearchOrStopButtonStyle}"
                        Command="{Binding SearchOrStopCommand}"
                        Content="{Binding SearchOrStopButtonText}" />

                <Button Grid.Column="3"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding RefreshButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="4"
                        Margin="0,0,8,0"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding EndSelectedProcessCommand}"
                        Content="{Binding EndProcessButton, Source={StaticResource ResourceWrapper}}" />

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Margin="0,14,0,0"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Text="{Binding ModeLabel, Source={StaticResource ResourceWrapper}}" />
                    <ComboBox Width="140"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding SearchModes}"
                              SelectedItem="{Binding SelectedSearchMode}" />
                    <CheckBox Margin="24,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding IncludeChildPaths, Source={StaticResource ResourceWrapper}}"
                              IsChecked="{Binding IncludeChildren}"
                              IsEnabled="{Binding IsDirectorySearchMode}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid ItemsSource="{Binding Results}"
                          CanUserResizeColumns="True"
                          CellStyle="{StaticResource ResultDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource ResultDataGridColumnHeaderStyle}"
                          IsReadOnly="True"
                          SelectionUnit="Cell"
                          SelectedCellsChanged="OnResultsSelectedCellsChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52"
                                            MinWidth="52"
                                            MaxWidth="52"
                                            CanUserResize="False"
                                            HeaderStyle="{StaticResource ResultSelectionColumnHeaderStyle}"
                                            CellStyle="{StaticResource ResultSelectionCellStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ResultSelectionCheckBoxStyle}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding LockInfo.ProcessName}" Header="{Binding GridProcess, Source={StaticResource ResourceWrapper}}" Width="2*" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.ProcessId}" Header="{Binding GridProcessId, Source={StaticResource ResourceWrapper}}" Width="90" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.UserName}" Header="{Binding GridUser, Source={StaticResource ResourceWrapper}}" Width="160" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.ProcessPath}" Header="{Binding GridExecutablePath, Source={StaticResource ResourceWrapper}}" Width="3*" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.LockedPath}" Header="{Binding GridLockedPath, Source={StaticResource ResourceWrapper}}" Width="3*" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.HandleType}" Header="{Binding GridHandleType, Source={StaticResource ResourceWrapper}}" Width="120" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                    <DataGridTextColumn Binding="{Binding LockInfo.Access}" Header="{Binding GridAccess, Source={StaticResource ResourceWrapper}}" Width="120" ElementStyle="{StaticResource ResultDataGridTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Margin="1"
                    Background="{StaticResource Brush.Surface}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Text="{Binding StatusMessage}" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,8"
                    Background="{StaticResource Brush.SurfaceMuted}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                           Text="{Binding StatusMessage}" />
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,8"
                    Background="{StaticResource Brush.SurfaceMuted}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,8"
                    Background="{StaticResource Brush.SurfaceMuted}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                           Text="{Binding ErrorMessage}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
