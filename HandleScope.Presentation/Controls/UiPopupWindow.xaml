<ui:FluentWindow x:Class="HandleScope.Presentation.Controls.UiPopupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440"
                 MinHeight="190"
                 SizeToContent="Height"
                 MaxHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 PreviewKeyDown="WindowPreviewKeyDown">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource SurfaceAltBrush}"
                  MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <Image Width="26"
                       Height="26"
                       Margin="10,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="{Binding AppIconPath}"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding PopupTitle}" />

                <ui:Button Grid.Column="2"
                           Style="{StaticResource TitleBarImageButtonStyle}"
                           ToolTip="{Binding CloseToolTip}"
                           Click="CloseButtonClick">
                    <Rectangle Width="18"
                               Height="18"
                               Fill="{StaticResource Brush.Danger}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding CloseIconPath}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ui:Button>
            </Grid>

            <Grid Grid.Row="1" Margin="22,24,22,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Width="38"
                       Height="38"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Source="{Binding IconPath}"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14"
                           LineHeight="21"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:Button Width="96"
                               Height="34"
                               Margin="0,0,8,0"
                               Padding="0"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Appearance="Secondary"
                               Background="{StaticResource Brush.Button}"
                               BorderBrush="{StaticResource Brush.ButtonBorder}"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Cursor="Hand"
                               Content="{Binding CancelButtonText}"
                               Visibility="{Binding CancelButtonVisibility}"
                               IsDefault="True"
                               IsCancel="True"
                               Click="CancelButtonClick" />
                    <ui:Button Width="96"
                               Height="34"
                               Padding="0"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Appearance="Primary"
                               Background="{StaticResource Brush.Accent}"
                               BorderBrush="{StaticResource Brush.Accent}"
                               Foreground="{StaticResource Brush.OnAccent}"
                               Cursor="Hand"
                               Content="{Binding ConfirmButtonText}"
                               Click="ConfirmButtonClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
