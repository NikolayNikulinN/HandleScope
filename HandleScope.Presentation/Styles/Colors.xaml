<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TransparentColor">Transparent</Color>
    <Color x:Key="WhiteColor">White</Color>
    <Color x:Key="AppBackgroundColor">#111821</Color>
    <Color x:Key="SurfaceColor">#1B2530</Color>
    <Color x:Key="SurfaceAltColor">#222F3B</Color>
    <Color x:Key="SurfaceHoverColor">#2B3A47</Color>
    <Color x:Key="PanelBorderColor">#354554</Color>
    <Color x:Key="AccentColor">#4AC4C5</Color>
    <Color x:Key="AccentHoverColor">#67D4D2</Color>
    <Color x:Key="AccentPressedColor">#2A989E</Color>
    <Color x:Key="AccentSoftColor">#1D4148</Color>
    <Color x:Key="TextColor">#EAF2F7</Color>
    <Color x:Key="GroupRowColor">#1B3447</Color>
    <Color x:Key="ValueTypeBadgeColor">#2C3D4D</Color>
    <Color x:Key="ExpandStringBadgeColor">#1B4A42</Color>
    <Color x:Key="ExpandStringBadgeTextColor">#86E2B2</Color>
    <Color x:Key="MutedTextColor">#A8B8C6</Color>
    <Color x:Key="ErrorTextColor">#FF9A92</Color>
    <Color x:Key="SoftDeleteButtonForegroundColor">#FFAAA6</Color>
    <Color x:Key="ResultColumnSeparatorColor">#3C4D5D</Color>
    <Color x:Key="DeleteButtonColor">#E87277</Color>
    <Color x:Key="SoftDeleteButtonBackgroundColor">#38303B</Color>
    <Color x:Key="SoftDeleteButtonBorderColor">#70434C</Color>
    <Color x:Key="SoftDeleteButtonHoverBackgroundColor">#563640</Color>
    <Color x:Key="DurationOverlayColor">#CC111111</Color>
    <Color x:Key="MediaListPanelBackgroundColor">#F01B2530</Color>

    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="GroupRowBrush" Color="{StaticResource GroupRowColor}" />
    <SolidColorBrush x:Key="ValueTypeBadgeBrush" Color="{StaticResource ValueTypeBadgeColor}" />
    <SolidColorBrush x:Key="ExpandStringBadgeBrush" Color="{StaticResource ExpandStringBadgeColor}" />
    <SolidColorBrush x:Key="ExpandStringBadgeTextBrush" Color="{StaticResource ExpandStringBadgeTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />
    <SolidColorBrush x:Key="ResultColumnSeparatorBrush" Color="{StaticResource ResultColumnSeparatorColor}" />

    <SolidColorBrush x:Key="DurationOverlayBrush" Color="{StaticResource DurationOverlayColor}" />
    <SolidColorBrush x:Key="DurationOverlayTextBrush" Color="White" />
    <SolidColorBrush x:Key="MediaListPanelBackgroundBrush" Color="{StaticResource MediaListPanelBackgroundColor}" />
    <SolidColorBrush x:Key="DeleteButtonIconBrush" Color="{StaticResource DeleteButtonColor}" />
    <SolidColorBrush x:Key="SoftDeleteButtonBackgroundBrush" Color="{StaticResource SoftDeleteButtonBackgroundColor}" />
    <SolidColorBrush x:Key="SoftDeleteButtonBorderBrush" Color="{StaticResource SoftDeleteButtonBorderColor}" />
    <SolidColorBrush x:Key="SoftDeleteButtonForegroundBrush" Color="{StaticResource SoftDeleteButtonForegroundColor}" />
    <SolidColorBrush x:Key="SoftDeleteButtonHoverBackgroundBrush" Color="{StaticResource SoftDeleteButtonHoverBackgroundColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315D6A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#263E4A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}" />

    <Color x:Key="Color.AppBackground">#FF111821</Color>
    <Color x:Key="Color.Surface">#FF1B2530</Color>
    <Color x:Key="Color.SurfaceMuted">#FF222F3B</Color>
    <Color x:Key="Color.Border">#FF354554</Color>
    <Color x:Key="Color.TextPrimary">#FFEAF2F7</Color>
    <Color x:Key="Color.TextSecondary">#FFA8B8C6</Color>
    <Color x:Key="Color.TextDisabled">#FF748695</Color>
    <Color x:Key="Color.Accent">#FF4AC4C5</Color>
    <Color x:Key="Color.AccentHover">#FF67D4D2</Color>
    <Color x:Key="Color.AccentPressed">#FF2A989E</Color>
    <Color x:Key="Color.OnAccent">#FF0B2028</Color>
    <Color x:Key="Color.Button">#FF273541</Color>
    <Color x:Key="Color.ButtonHover">#FF344856</Color>
    <Color x:Key="Color.ButtonPressed">#FF20303C</Color>
    <Color x:Key="Color.ButtonBorder">#FF486070</Color>
    <Color x:Key="Color.Danger">#FFE8787E</Color>
    <Color x:Key="Color.DangerSurface">#FF3B2730</Color>
    <Color x:Key="Color.DangerHover">#FF56303A</Color>
    <Color x:Key="Color.StopButton">#FF742D39</Color>
    <Color x:Key="Color.StopButtonHover">#FF8C3846</Color>
    <Color x:Key="Color.StopButtonPressed">#FF5D242E</Color>
    <Color x:Key="Color.StopButtonBorder">#FFB65A69</Color>
    <Color x:Key="Color.ResultHeader">#FF283847</Color>
    <Color x:Key="Color.ResultHeaderDivider">#FF607789</Color>

    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Button" Color="{StaticResource Color.Button}" />
    <SolidColorBrush x:Key="Brush.ButtonHover" Color="{StaticResource Color.ButtonHover}" />
    <SolidColorBrush x:Key="Brush.ButtonPressed" Color="{StaticResource Color.ButtonPressed}" />
    <SolidColorBrush x:Key="Brush.ButtonBorder" Color="{StaticResource Color.ButtonBorder}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.StopButton" Color="{StaticResource Color.StopButton}" />
    <SolidColorBrush x:Key="Brush.StopButtonHover" Color="{StaticResource Color.StopButtonHover}" />
    <SolidColorBrush x:Key="Brush.StopButtonPressed" Color="{StaticResource Color.StopButtonPressed}" />
    <SolidColorBrush x:Key="Brush.StopButtonBorder" Color="{StaticResource Color.StopButtonBorder}" />
    <SolidColorBrush x:Key="Brush.ResultHeader" Color="{StaticResource Color.ResultHeader}" />
    <SolidColorBrush x:Key="Brush.ResultHeaderDivider" Color="{StaticResource Color.ResultHeaderDivider}" />
</ResourceDictionary>
